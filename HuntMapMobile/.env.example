SECRET_KEY=
DEBUG=

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

ANTHROPIC_API_KEY=

# Google Maps API key — used for the web map, Places search and Geocoding
# EXPO_PUBLIC_ prefix is required by Expo to expose this to the client bundle.
#
# SECURITY: anything prefixed EXPO_PUBLIC_ is shipped inside the app/web bundle
# and is visible to end users. Treat this key as public and lock it down in
# Google Cloud Console -> APIs & Services -> Credentials:
#   - Application restrictions: HTTP referrers (localhost:8081 + your web domain)
#   - API restrictions: only Maps JavaScript API, Places API, Geocoding API
# Never commit the real .env file (it is gitignored). For EAS builds, set this
# as an EAS environment variable instead of putting it in the repo.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
